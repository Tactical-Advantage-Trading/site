{{ if .Site.Data.content.ewallet.enable }} {{ with .Site.Data.content.ewallet
}}
<section class="about-me eWallet-section" id="eWallet">
  <div class="container">
    {{ $sections := .sections }}
    <div class="row eWallet-layout justify-content-between">
      <div
        class="col-12 col-lg-8 col-xl-8 order-2 order-lg-1 about-me-text text-left"
      >
        <div class="text-holder eWallet-shell">
          <h1>{{ .title | safeHTML }}</h1>
          {{ with .intro }}
          <div class="eWallet-intro">{{ . | markdownify | emojify }}</div>
          {{ end }}
          {{ with .links }}
          <div class="about-links eWallet-links">
            {{ range . }}
            <div class="about-link">
              <span class="about-link-label">{{ .label }}</span>
              <a
                class="about-link-value"
                href="{{ .href }}"
                {{ if hasPrefix .href "http" }}target="_blank" rel="noreferrer"{{ end }}
              >
                {{ .value }}
              </a>
            </div>
            {{ end }}
          </div>
          {{ end }}
          {{ with .install_note }}
          <section class="eWallet-note">
            {{ with .title }}
            <h2>{{ . }}</h2>
            {{ end }}
            <div class="eWallet-note-copy">
              {{ .content | markdownify | emojify }}
            </div>
          </section>
          {{ end }}
          {{ with .sections }}
          <div class="eWallet-manual">
            {{ range . }}
            <article class="eWallet-item" id="{{ .title | anchorize }}">
              <h3>{{ .title }}</h3>
              <div class="eWallet-item-copy">
                {{ .content | markdownify | emojify }}
              </div>
              {{ with .example }}
              <pre class="eWallet-example"><code>{{ . }}</code></pre>
              {{ end }}
              {{ with .after_example }}
              <div class="eWallet-item-copy">
                {{ . | markdownify | emojify }}
              </div>
              {{ end }}
            </article>
            {{ end }}
          </div>
          {{ end }}
        </div>
      </div>
      {{ with $sections }}
      <aside class="col-12 col-lg-3 col-xl-3 order-1 order-lg-2 eWallet-sidebar-wrap">
        <nav class="eWallet-side-menu" aria-label="eWallet section links">
          <span class="eWallet-side-menu-label">Contents</span>
          <ul class="eWallet-side-menu-list">
            {{ range . }}
            <li>
              <a href="#{{ .title | anchorize }}">{{ .title }}</a>
            </li>
            {{ end }}
          </ul>
        </nav>
      </aside>
      {{ end }}
    </div>
  </div>
</section>
{{ end }} {{ end }}
